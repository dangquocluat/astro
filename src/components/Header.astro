---
import { SITE_TITLE } from "../consts";
---

<header class="header">
	<nav class="nav-container">
		<div class="nav-brand">
			<a href="/">
				<svg
					width="32"
					height="32"
					viewBox="0 0 24 24"
					fill="currentColor"
				>
					<path
						d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"
					></path>
				</svg>
				<span>{SITE_TITLE}</span>
			</a>
		</div>
		<div class="nav-links">
			<a href="/">Home</a>
			<a href="/privacy">Privacy</a>
			<a href="/terms">Terms</a>
			<a href="https://dash.luryon.com">Dashboard</a>
		</div>
	</nav>
</header>

<style>
	/* Global reset for header positioning context if needed, though usually on body */

	.header {
		position: fixed;
		top: 2rem;
		left: 0;
		right: 0;
		z-index: 1000;
		display: flex;
		justify-content: center;
		padding: 0 1rem;
		pointer-events: none; /* Allow clicking through to content on sides */
	}

	.nav-container {
		pointer-events: auto; /* Re-enable pointer events for the nav itself */
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 2rem;
		width: 100%;
		max-width: 900px; /* Limit width for the floating effect */
		background: rgba(
			22,
			22,
			24,
			0.6
		); /* Darker semi-transparent background */
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 100px; /* Pill shape */
		box-shadow:
			0 4px 24px -1px rgba(0, 0, 0, 0.2),
			0 0 0 1px rgba(255, 255, 255, 0.05) inset;
		transition: all 0.3s ease;
	}

	.nav-brand a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: #fff;
		font-weight: 600;
		font-size: 1.1rem;
		transition: transform 0.2s ease;
	}

	.nav-brand a:hover {
		transform: scale(1.02);
	}

	.nav-brand svg {
		width: 28px;
		height: 28px;
		color: #fff;
	}

	.nav-links {
		display: flex;
		gap: 0.5rem; /* Reduced gap for button-like links */
		align-items: center;
	}

	.nav-links a {
		text-decoration: none;
		color: rgba(255, 255, 255, 0.7);
		font-weight: 500;
		font-size: 0.95rem;
		padding: 0.5rem 1rem;
		border-radius: 50px;
		transition: all 0.2s ease;
	}

	.nav-links a:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
	}

	.nav-links a.active {
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
	}

	/* Optional: Special styling for the Dashboard link (CTA) */
	.nav-links a[href*="dashboard"] {
		/* If you want it to look distinct */
		/* background: var(--discord-blurple, #5865F2); */
		/* color: white; */
	}

	@media (max-width: 768px) {
		.header {
			top: 1rem;
		}

		.nav-container {
			padding: 0.75rem 1.5rem;
			width: 100%;
		}

		.nav-brand a span {
			display: none;
		}

		.nav-links {
			gap: 0.25rem;
		}

		.nav-links a {
			padding: 0.4rem 0.8rem;
			font-size: 0.9rem;
		}
	}
</style>
