---
import { SITE_TITLE } from "../consts";
---

<header class="header">
	<nav class="nav-container">
		<div class="nav-brand">
			<a href="/">
				<img src="/logo.png" alt="Logo" class="w-12 h-12"/>
				<span>Luryon</span>
			</a>
		</div>
		<div class="nav-links">
			<a href="/">Home</a>
			<a href="/privacy">Privacy</a>
			<a href="/terms">Terms</a>
			<a href="https://dash.luryon.com">Dashboard</a>
		</div>
	</nav>
</header>

<style>
	/* Global reset for header positioning context if needed, though usually on body */

	.header {
		position: fixed;
		top: 2rem;
		left: 0;
		right: 0;
		z-index: 1000;
		display: flex;
		justify-content: center;
		padding: 0 1rem;
		pointer-events: none; /* Allow clicking through to content on sides */
	}

	.nav-container {
		pointer-events: auto; /* Re-enable pointer events for the nav itself */
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 2rem;
		width: 100%;
		max-width: 900px; /* Limit width for the floating effect */
		background: rgba(
			22,
			22,
			24,
			0.6
		); /* Darker semi-transparent background */
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 100px; /* Pill shape */
		box-shadow:
			0 4px 24px -1px rgba(0, 0, 0, 0.2),
			0 0 0 1px rgba(255, 255, 255, 0.05) inset;
		transition: all 0.3s ease;
	}

	.nav-brand a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: #fff;
		font-weight: 600;
		font-size: 1.1rem;
		transition: transform 0.2s ease;
	}

	.nav-brand a:hover {
		transform: scale(1.02);
	}

	.nav-brand svg {
		width: 28px;
		height: 28px;
		color: #fff;
	}

	.nav-links {
		display: flex;
		gap: 0.5rem; /* Reduced gap for button-like links */
		align-items: center;
	}

	.nav-links a {
		text-decoration: none;
		color: rgba(255, 255, 255, 0.7);
		font-weight: 500;
		font-size: 0.95rem;
		padding: 0.5rem 1rem;
		border-radius: 50px;
		transition: all 0.2s ease;
	}

	.nav-links a:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
	}

	.nav-links a.active {
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
	}

	/* Optional: Special styling for the Dashboard link (CTA) */
	.nav-links a[href*="dashboard"] {
		/* If you want it to look distinct */
		/* background: var(--discord-blurple, #5865F2); */
		/* color: white; */
	}

	@media (max-width: 768px) {
		.header {
			top: 1rem;
		}

		.nav-container {
			padding: 0.75rem 1.5rem;
			width: 100%;
		}

		.nav-brand a span {
			display: none;
		}

		.nav-links {
			gap: 0.25rem;
		}

		.nav-links a {
			padding: 0.4rem 0.8rem;
			font-size: 0.9rem;
		}
	}
</style>
