---
import { SITE_TITLE } from "../consts";
const today = new Date();
---

<footer class="footer">
	<div class="footer-container">
		<div class="footer-grid">
			<div class="footer-brand">
				<div class="brand-logo">
					<svg
						width="32"
						height="32"
						viewBox="0 0 24 24"
						fill="currentColor"
					>
						<path
							d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"
						></path>
					</svg>
					<span>{SITE_TITLE}</span>
				</div>
				<p class="brand-description">
					Powerful Discord bot management dashboard for modern
					communities.
				</p>
			</div>

			<div class="footer-links">
				<h4>Product</h4>
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/blog">Blog</a>
				<a href="https://dash.luryon.com">Dashboard</a>
			</div>

			<div class="footer-links">
				<h4>Legal</h4>
				<a href="/privacy">Privacy Policy</a>
				<a href="/terms">Terms of Service</a>
			</div>

			<div class="footer-links">
				<h4>Community</h4>
				<a
					href="https://discord.gg/6rTJDw7gWA"
					target="_blank"
					rel="noopener noreferrer">Discord Server</a
				>
				<a
					href="https://github.com/dangquocluat"
					target="_blank"
					rel="noopener noreferrer">GitHub</a
				>
			</div>
		</div>

		<div class="footer-bottom">
			<p>
				&copy; {today.getFullYear()}
				{SITE_TITLE}. All rights reserved.
			</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: linear-gradient(180deg, #ffffff 0%, #f8f9ff 100%);
		padding: 4rem 2rem 2rem;
		border-top: 1px solid rgba(0, 0, 0, 0.05);
	}

	.footer-container {
		max-width: 1400px;
		margin: 0 auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: 3rem;
		margin-bottom: 3rem;
	}

	.footer-brand {
		max-width: 350px;
	}

	.brand-logo {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
		color: var(--discord-blurple);
	}

	.brand-logo svg {
		width: 32px;
		height: 32px;
	}

	.brand-logo span {
		font-size: 1.25rem;
		font-weight: 700;
	}

	.brand-description {
		color: rgb(var(--gray));
		line-height: 1.6;
		margin: 0;
	}

	.footer-links h4 {
		font-size: 1rem;
		font-weight: 700;
		margin-bottom: 1rem;
		color: rgb(var(--black));
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-links a {
		color: rgb(var(--gray));
		text-decoration: none;
		transition: all 0.3s ease;
		font-size: 0.95rem;
	}

	.footer-links a:hover {
		color: var(--discord-blurple);
		transform: translateX(4px);
	}

	.footer-bottom {
		padding-top: 2rem;
		border-top: 1px solid rgba(0, 0, 0, 0.05);
		text-align: center;
	}

	.footer-bottom p {
		color: rgb(var(--gray));
		margin: 0;
		font-size: 0.9rem;
	}

	@media (max-width: 1024px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
	}

	@media (max-width: 640px) {
		.footer {
			padding: 3rem 1rem 1.5rem;
		}

		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.footer-brand {
			max-width: 100%;
		}
	}
</style>
